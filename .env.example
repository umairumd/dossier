NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required in production for invite links.
# Set to your deployment URL e.g. https://inoma-hub.vercel.app
# On Vercel, VERCEL_URL is auto-injected so this is only needed
# for custom domains. (lib/helpers/site-url.ts)
SITE_URL=

# Optional client-side override for the app origin used in invite-link
# redirects. Prefer SITE_URL / VERCEL_URL on the server; this is a
# build-time fallback. Local development falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Server-only — never prefix with NEXT_PUBLIC_. Used exclusively by
# lib/supabase/admin.ts for the Admin API (inviting/banning users). Bypasses
# RLS entirely; every caller must independently verify the requester is an
# admin before using it (see lib/supabase/require-admin.ts).
SUPABASE_SERVICE_ROLE_KEY=
