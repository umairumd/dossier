NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — overrides the app origin used to build invite-link redirects
# (lib/helpers/site-url.ts). Only needed for a custom production domain;
# Vercel's own VERCEL_URL is picked up automatically otherwise, and local
# dev falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Server-only — never prefix with NEXT_PUBLIC_. Used exclusively by
# lib/supabase/admin.ts for the Admin API (inviting/banning users). Bypasses
# RLS entirely; every caller must independently verify the requester is an
# admin before using it (see lib/supabase/require-admin.ts).
SUPABASE_SERVICE_ROLE_KEY=
